generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                 String              @id @default(uuid())
  name               String
  category           String?
  onboarded          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  forecastResults    ForecastResult[]
  insights           Insight[]
  inventoryLogs      InventoryLog[]
  invitations        Invitation[]
  products           Product[]
  reorderSuggestions ReorderSuggestion[]
  restockAlerts      RestockAlert[]
  suppliers          Supplier[]
  systemLogs         SystemLog[]
  transactions       Transaction[]
  users              User[]
}

model User {
  user_id       String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String         @unique
  password_hash String
  role          String
  created_at    DateTime       @default(now())
  store_id      String
  inventoryLogs InventoryLog[]
  transactions  Transaction[]
  store         Store          @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model Supplier {
  supplier_id     String    @id @default(uuid())
  name            String
  company_name    String?
  contact         String
  whatsapp_number String?
  email           String?
  location        String?
  lead_time_days  Int       @default(0)
  payment_terms   String?
  notes           String?
  store_id        String
  products        Product[]
  store           Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model Product {
  product_id      String           @id @default(uuid())
  name            String
  category        String
  selling_price   Decimal          @default(0)
  buying_price    Decimal          @default(0)
  stock_quantity  Int              @default(0)
  reorder_level   Int              @default(10)
  supplier_id     String?
  created_at      DateTime         @default(now())
  image_url       String?
  store_id        String
  forecastResults ForecastResult[]
  inventoryLogs   InventoryLog[]
  store           Store            @relation(fields: [store_id], references: [id], onDelete: Cascade)
  supplier        Supplier?        @relation(fields: [supplier_id], references: [supplier_id])
  restockAlerts   RestockAlert[]
  transactions    Transaction[]
}

model Transaction {
  transaction_id   String        @id @default(uuid())
  receipt_id       String?       @default(cuid())
  product_id       String
  user_id          String
  quantity         Int
  total_price      Decimal
  total_profit     Decimal       @default(0)
  payment_method   String        @default("CASH")
  status           String        @default("COMPLETED")
  transaction_type String
  store_id         String
  voided_at        DateTime?
  created_at       DateTime      @default(now())
  inventoryLog     InventoryLog?
  product          Product       @relation(fields: [product_id], references: [product_id])
  store            Store         @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [user_id], references: [user_id])
}

model InventoryLog {
  log_id           String       @id @default(uuid())
  product_id       String
  change_type      String
  quantity_changed Int
  timestamp        DateTime     @default(now())
  store_id         String
  created_at       DateTime     @default(now())
  reason           String?
  transaction_id   String?      @unique
  user_id          String?
  product          Product      @relation(fields: [product_id], references: [product_id])
  store            Store        @relation(fields: [store_id], references: [id], onDelete: Cascade)
  transaction      Transaction? @relation(fields: [transaction_id], references: [transaction_id])
  user             User?        @relation(fields: [user_id], references: [user_id])
}

model ForecastResult {
  forecast_id      String   @id @default(uuid())
  store_id         String
  product_id       String
  predicted_demand Int
  forecast_period  String
  created_at       DateTime @default(now())
  product          Product  @relation(fields: [product_id], references: [product_id])
  store            Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model ReorderSuggestion {
  suggestions_id     String   @id @default(uuid())
  store_id           String
  product_id         String
  suggested_quantity Int
  reason             String?
  created_at         DateTime @default(now())
  store              Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model Insight {
  insight_id String   @id @default(uuid())
  store_id   String
  query      String
  response   String
  created_at DateTime @default(now())
  store      Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model Invitation {
  id         String   @id @default(uuid())
  store_id   String
  email      String?
  phone      String?
  role       String   @default("attendant")
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
  store      Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model RestockAlert {
  id                   String   @id @default(uuid())
  store_id             String
  product_id           String
  recommended_quantity Int
  urgency              String
  status               String   @default("PENDING_APPROVAL")
  created_at           DateTime @default(now())
  product              Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  store                Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model SystemLog {
  id         String   @id @default(uuid())
  store_id   String
  type       String
  content    String
  created_at DateTime @default(now())
  store      Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
}
